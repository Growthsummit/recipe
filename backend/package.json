{
  "name": "recipebox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Turso (libSQL) backend for the RecipeBox / RecipeHub application",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node scripts/initializeDatabase.js",
    "seed": "node scripts/seedDatabase.js",
    "export:ai": "node scripts/exportAiDataset.js",
    "test": "node test/api.test.js",
    "blockchain:compile": "node ../blockchain/scripts/compile-contract.mjs",
    "blockchain:test": "npm run blockchain:compile && node --test test/blockchainHash.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.11",
    "solc": "0.8.36"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
