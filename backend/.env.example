# ---------------------------------------------------------------------------
# RecipeBox backend - example environment file
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on
PORT=5000
NODE_ENV=development

# Turso / libSQL connection
# Database URL looks like: libsql://<database>-<org>.aws-<region>.turso.io
TURSO_DATABASE_URL=libsql://your-database-your-org.aws-xx-xxxx-x.turso.io
# Auth token created with `turso db tokens create <database>`
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# JWT signing secret - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional: accounts created by `npm run seed`
# Set each password to a unique high-entropy value before running the seed command.
SEED_ADMIN_NAME=RecipeBox Admin
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-unique-random-secret

SEED_SECURITY_NAME=RecipeBox Security
SEED_SECURITY_EMAIL=security-admin@example.invalid
SEED_SECURITY_PASSWORD=replace-with-a-different-unique-random-secret

# Password reset email delivery via Resend (use a verified sender in production)
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=RecipeBox <verified-sender@example.invalid>
FRONTEND_URL=http://localhost:5173

# Optional external Python inference service for AI features
AI_SERVICE_URL=http://127.0.0.1:8000/
AI_SERVICE_TOKEN=replace-with-a-random-private-service-token
AI_SERVICE_TIMEOUT_MS=15000

# Ethereum Sepolia public read RPC and deployed RecipeRegistry address.
# Obtain these from your RPC provider and your own Remix deployment. Never put a wallet key here.
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=11155111
