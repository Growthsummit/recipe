# Base URL of the RecipeBox backend API.
#
# Local development (backend in ./backend listens on port 5000):
VITE_API_URL=http://localhost:5000/api
#
# Production (Vercel): set this in the Vercel project's Environment Variables
# to the deployed Render service URL, for example:
# VITE_API_URL=https://recipebox-api.onrender.com/api
VITE_SECURITY_PORTAL_URL=http://localhost:5174
